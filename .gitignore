# ==========================================================
# FocusPets - Android project .gitignore
# Track source, build scripts and the Gradle wrapper.
# Ignore machine-local outputs, IDE caches and signing credentials.
# Comments must start on their own line; inline comments are unsupported.
# ==========================================================

# ---------- Gradle build outputs ----------
.gradle/
build/
app/build/
captures/
.externalNativeBuild/
.cxx/

# Machine-specific SDK paths must not be committed.
local.properties

# Commit gradlew, gradlew.bat, gradle/wrapper/gradle-wrapper.jar
# and gradle-wrapper.properties so a fresh clone can build.

# ---------- Android Studio / IntelliJ ----------
*.iml
.idea/

# ---------- Signing credentials (keep private) ----------
*.jks
*.keystore
keystore.properties
signing.properties

# ---------- Native builds / NDK ----------
obj/

# ---------- Packaged outputs ----------
*.apk
*.aab
*.ap_
*.dex
bin/
gen/
out/

# ---------- Logs and crash reports ----------
*.log
hs_err_pid*

# ---------- Operating system temporary files ----------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# ---------- VS Code ----------
.vscode/
.history/

# ---------- Local working data (not part of the project) ----------
# WorkBuddy sessions and memory
.workbuddy/
# Local study notes (remove the next pattern to track them)
.memory/

# ---------- Source artwork (optional exclusion for large originals) ----------
# artwork/
# tools/originals/

# ---------- Generated previews / test outputs ----------
tools/preview_*.png
tools/_test_*.png
tools/*preview*.html
tools/rembg_run.log

# ---------- Local database snapshots ----------
*.db

/tmp/
/output/
node_modules/
__pycache__/
*.pyc
