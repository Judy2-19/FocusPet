<?xml version="1.0" encoding="utf-8"?>
<!-- Soft GLOW halo: warm gold center fading outward instead of a hard outline; alpha/scale pulses create a glow around the cat. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="150dp"
        android:centerX="0.5"
        android:centerY="0.5"
        android:centerColor="#B3FFD54F"
        android:endColor="#00FFFFFF" />
</shape>
