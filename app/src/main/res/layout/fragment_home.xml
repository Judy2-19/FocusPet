<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_background">

    <!-- Top bar: title and Collection entry. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="我的伙伴"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pokedex"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖 图鉴"
            app:cornerRadius="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="⚙ 设置"
            app:cornerRadius="20dp" />
    </LinearLayout>

    <!-- Pet stage: tap/swipe to switch pets; show a gold halo in GLOW mood. -->
    <FrameLayout
        android:id="@+id/pet_touch_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="宠物舞台：点击或左右滑动切换宠物"
        android:importantForAccessibility="yes">

        <View
            android:id="@+id/v_glow"
            android:layout_width="340dp"
            android:layout_height="340dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_glow_circle"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <!-- Cat artwork for pet 1, dynamically loaded from assets based on equipment. -->
        <ImageView
            android:id="@+id/iv_pet_cat"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tv_pet_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🐱"
            android:textSize="130sp"
            android:importantForAccessibility="no" />

        <!-- Forehead thermometer sticker for sick mood. -->
        <TextView
            android:id="@+id/tv_pet_sick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:translationX="46dp"
            android:translationY="-74dp"
            android:text="🤒"
            android:textSize="40sp"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <!-- Meow speech bubble. -->
        <TextView
            android:id="@+id/tv_meow_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="?attr/colorSurfaceVariant"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="喵~"
            android:textSize="15sp"
            android:translationX="72dp"
            android:translationY="-96dp"
            android:visibility="gone"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Bottom information area. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tv_pet_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="小水滴"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_mood_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:text="😊 陪伴中"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <!-- Point progress toward the next affordable locked pet. -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:max="100"
            app:indicatorColor="@color/cat_accent"
            app:trackColor="@color/progress_track"
            app:trackCornerRadius="6dp"
            app:trackThickness="10dp" />

        <TextView
            android:id="@+id/tv_progress_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="距解锁 🐶 小狗 还差 50 积分"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_collection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="已收集 1 / 9"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="点击宠物切换 · 左右滑动也可以"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />

        <!-- Cat wardrobe shown only for pet 1. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_wardrobe"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="🐱 装扮小猫"
            android:visibility="gone"
            app:cornerRadius="16dp" />

        <!-- Change background using the soft palette. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bg"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="🎨 换背景"
            app:cornerRadius="16dp" />

        <!-- Debug mood-cycle button for test builds only. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_debug_mood"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="🎭 调试心情：普通"
            app:cornerRadius="16dp" />

    </LinearLayout>
</LinearLayout>
