<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- 顶部栏：标题（左）+ 专注记录入口（右上角） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="专注"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_records"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 记录"
                android:textSize="13sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>

        <!-- 本次专注内容：记录 + 复用历史 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/stroke_hint"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="本次专注内容"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="写代码 / 看书 / 写报告…">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_focus_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        android:imeOptions="actionNext" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tv_history_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="最近用过"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:visibility="gone" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 宠物饥饿提醒（专注失败时显示） -->
        <TextView
            android:id="@+id/tv_hunger_warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="😿 宠物饿坏了…完成一次专注让它恢复健康"
            android:textColor="#E53935"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 剩余时间 -->
        <TextView
            android:id="@+id/tv_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:text="25:00"
            android:textSize="64sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:contentDescription="剩余专注时间" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="选择时长，开始一次专注"
            android:textColor="@color/text_hint"
            android:textSize="14sp" />

        <!-- 进度条：已专注时长占比（自定义：橘色已走 + 白色未走 + 黑色竖线分割） -->
        <com.example.focuspets.ui.focus.FocusProgressBar
            android:id="@+id/progress_focus"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="32dp"
            android:contentDescription="专注进度" />

        <!-- 时长选择：15 / 25 / 45 分钟 -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:checkedButton="@id/btn_25"
            app:selectionRequired="false"
            app:singleSelection="true">

            <Button
                android:id="@+id/btn_15"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 分钟" />

            <Button
                android:id="@+id/btn_25"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25 分钟" />

            <Button
                android:id="@+id/btn_45"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45 分钟" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- 自定义时长 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="自定义分钟（1~180）">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_custom_minutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="3"
                    android:text="25" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_custom"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="应用" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_preset"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="⭐ 存为预设"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 常用预设：点击一键套用「内容 + 时长」 -->
        <TextView
            android:id="@+id/tv_preset_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="常用预设"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:visibility="gone" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_presets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="6dp" />

        <!-- 开始 / 放弃 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="40dp"
            android:text="开始专注"
            android:textSize="16sp"
            app:cornerRadius="30dp" />

        <TextView
            android:id="@+id/tv_points_focus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="可用积分 0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="🍅 专注期间请保持 App 在前台\n切后台超过 5 秒，本次专注将失败"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
