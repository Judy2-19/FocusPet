<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- 宠物饥饿提醒（专注失败时显示） -->
        <TextView
            android:id="@+id/tv_hunger_warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="😿 宠物饿坏了…完成一次专注让它恢复健康"
            android:textColor="#E53935"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 剩余时间 -->
        <TextView
            android:id="@+id/tv_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:text="25:00"
            android:textSize="64sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="选择时长，开始一次专注"
            android:textColor="#757575"
            android:textSize="14sp" />

        <!-- 进度条：已专注时长占比 -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_focus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:max="100"
            app:indicatorColor="#FF7043"
            app:trackColor="#F5F5F5"
            app:trackCornerRadius="6dp"
            app:trackThickness="12dp" />

        <!-- 时长选择：15 / 25 / 45 分钟 -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:checkedButton="@id/btn_25"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/btn_15"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 分钟" />

            <Button
                android:id="@+id/btn_25"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25 分钟" />

            <Button
                android:id="@+id/btn_45"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45 分钟" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- 开始 / 放弃 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="40dp"
            android:text="开始专注"
            android:textSize="16sp"
            app:cornerRadius="30dp" />

        <TextView
            android:id="@+id/tv_points_focus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="可用积分 0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="🍅 专注期间请保持 App 在前台\n切后台超过 5 秒，本次专注将失败"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
