<?xml version="1.0" encoding="utf-8"?>
<!-- Night colors activate automatically with Theme.Material3.DayNight. -->
<resources>
    <!-- Warm dark-gray page/window background replaces light cream to maintain contrast. -->
    <color name="page_background">#1C1916</color>
    <!-- Primary/secondary text: warm white and soft gray, readable on dark surfaces. -->
    <color name="text_primary">#EDE6DD</color>
    <color name="text_hint">#9C948A</color>
    <!-- Slightly brighter accent for dark backgrounds. -->
    <color name="cat_accent">#FFC94D</color>
    <!-- Increase rarity-color brightness to avoid dull colors on dark surfaces. -->
    <color name="rarity_common">#B0B0B0</color>
    <color name="rarity_rare">#64B5F6</color>
    <color name="rarity_legend">#FFCA28</color>
    <!-- Surface elements: cards, outlines, and progress tracks. -->
    <color name="surface_card">#2A2520</color>
    <color name="surface_card_locked">#221E1A</color>
    <color name="stroke_hint">#4A4540</color>
    <color name="progress_track">#3A3530</color>
</resources>
