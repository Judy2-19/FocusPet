<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground service notifications require runtime permission on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Network state: ordinary permission required by ConnectivityManager.registerNetworkCallback; no runtime request. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Internet access for cloud sync and leaderboards; no runtime request required. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Foreground service permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Vibration for completion alerts; ordinary permission with no runtime request. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- API 34+: use specialUse for foreground services outside standard media/location categories. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Foreground app detection for the lock allowlist requires special Usage Access permission, granted in Settings. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".FocusPetsApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusPets"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Crash screen launched by the global exception handler; displays the stack trace without database or cloud dependencies. -->
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />

        <!-- First-run guide: MainActivity checks whether onboarding is complete before opening Home. -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- Settings: sign out, delete account, reset progress, and reopen onboarding. -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- Full-screen focus lock with screen pinning; singleTask avoids duplicate stack entries. -->
        <activity
            android:name=".ui.lock.LockActivity"
            android:exported="false"
            android:launchMode="singleTask" />

        <!-- Lock allowlist: select installed apps that remain available during locking. -->
        <activity
            android:name=".ui.lock.LockWhitelistActivity"
            android:exported="false"
            android:label="Allowed apps in lock mode"
            android:parentActivityName=".ui.lock.LockActivity"
            android:theme="@style/Theme.FocusPets" />

        <!-- Focus records: day/week/month/year filters, record list, and shareable content pie chart. -->
        <activity
            android:name=".ui.focus.FocusRecordsActivity"
            android:exported="false"
            android:theme="@style/Theme.FocusPets" />

        <!-- Full-screen pet card: immersive WebView rendered with three.js, supporting rotation, zoom, and flipping. -->
        <activity
            android:name=".ui.collection.PetCardActivity"
            android:exported="false"
            android:theme="@style/Theme.FocusPets"
            android:launchMode="singleTop" />

        <!-- Focus timer foreground service with specialUse type and subtype description. -->
        <service
            android:name=".service.FocusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="focus_countdown_timer" />
        </service>

        <!-- Expose achievement poster images under cache/posters through content:// for sharing. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
